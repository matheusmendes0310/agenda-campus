{
  "info": {
    "name": "Agenda Campus - API REST",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Execute na ordem. O login salva o token JWT na variável {{token}}, que é enviado automaticamente como Bearer Token nas demais requisições."
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080/api"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "eventoId",
      "value": ""
    },
    {
      "key": "participanteId",
      "value": ""
    },
    {
      "key": "inscricaoId",
      "value": ""
    },
    {
      "key": "dataEvento",
      "value": ""
    },
    {
      "key": "outroEventoId",
      "value": ""
    },
    {
      "key": "rodada",
      "value": ""
    },
    {
      "key": "senhaAdmin",
      "value": "admin123"
    },
    {
      "key": "senhaComum",
      "value": "comum123"
    },
    {
      "key": "outraData",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Autenticação",
      "item": [
        {
          "name": "Sem token (espera 401)",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "url": "{{baseUrl}}/inscricoes"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('HTTP 401', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        },
        {
          "name": "Login com senha errada (espera 401)",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"login\": \"admin\",\n  \"senha\": \"errada\"\n}"
            },
            "url": "{{baseUrl}}/auth/login"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('HTTP 401', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        },
        {
          "name": "Login ADMIN (salva o token)",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"login\": \"admin\",\n  \"senha\": \"{{senhaAdmin}}\"\n}"
            },
            "url": "{{baseUrl}}/auth/login"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.test('Perfil ADMIN recebido', () => pm.expect(pm.response.json().perfil).to.eql('ADMIN'));",
                  "if (pm.response.code === 200) pm.collectionVariables.set('token', pm.response.json().token);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. Eventos e participantes",
      "item": [
        {
          "name": "Criar evento",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Workshop de Postman {{rodada}}\",\n  \"data\": \"{{dataEvento}}\",\n  \"local\": \"Laboratório 05\",\n  \"vagas\": 20\n}"
            },
            "url": "{{baseUrl}}/eventos"
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const d = new Date(); d.setDate(d.getDate() + 10);",
                  "pm.collectionVariables.set('dataEvento', d.toISOString().slice(0, 10));",
                  "pm.collectionVariables.set('rodada', String(Date.now()));",
                  "d.setDate(d.getDate() + 1); pm.collectionVariables.set('outraData', d.toISOString().slice(0, 10));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('eventoId', pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Criar segundo evento para testar edição e filtro",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Workshop de Postman {{rodada}}\",\n  \"data\": \"{{outraData}}\",\n  \"local\": \"Laboratório 05\",\n  \"vagas\": 20\n}"
            },
            "url": "{{baseUrl}}/eventos"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
                  "if (pm.response.code === 201) pm.collectionVariables.set('outroEventoId', pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Criar participante",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Participante Postman\",\n  \"email\": \"postman{{rodada}}@email.com\"\n}"
            },
            "url": "{{baseUrl}}/participantes"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('participanteId', pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Criar evento inválido (espera 400)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"\",\n  \"local\": \"Lab\",\n  \"vagas\": 0\n}"
            },
            "url": "{{baseUrl}}/eventos"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('HTTP 400', () => pm.response.to.have.status(400));"
                ]
              }
            }
          ]
        },
        {
          "name": "Listar eventos",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/eventos"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Buscar evento por ID",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/eventos/{{eventoId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Busca com múltiplos parâmetros (nome + data)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/eventos?nome={{rodada}}&data={{dataEvento}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "eventos"
              ],
              "query": [
                {
                  "key": "nome",
                  "value": "{{rodada}}"
                },
                {
                  "key": "data",
                  "value": "{{dataEvento}}"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.test('Somente o evento com o nome e a data informados', () => {",
                  "  pm.expect(pm.response.json().map(e => e.id)).to.eql([Number(pm.collectionVariables.get('eventoId'))]);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Listar participantes",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/participantes"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "3. CRUD de inscrições",
      "item": [
        {
          "name": "Criar inscrição",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"eventoId\": {{eventoId}},\n  \"participanteId\": {{participanteId}}\n}"
            },
            "url": "{{baseUrl}}/inscricoes"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('inscricaoId', pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Criar inscrição repetida (espera 400)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"eventoId\": {{eventoId}},\n  \"participanteId\": {{participanteId}}\n}"
            },
            "url": "{{baseUrl}}/inscricoes"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('HTTP 400', () => pm.response.to.have.status(400));"
                ]
              }
            }
          ]
        },
        {
          "name": "Listar inscrições",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/inscricoes"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Buscar inscrição por ID",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/inscricoes/{{inscricaoId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Filtro no path: participantes do evento",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/eventos/{{eventoId}}/participantes"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.test('Participante aparece no evento', () => {",
                  "  pm.expect(pm.response.json().map(p => p.id)).to.include(Number(pm.collectionVariables.get('participanteId')));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Atualizar inscrição (troca para o segundo evento)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"eventoId\": {{outroEventoId}},\n  \"participanteId\": {{participanteId}}\n}"
            },
            "url": "{{baseUrl}}/inscricoes/{{inscricaoId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.test('Inscrição mudou de evento', () => pm.expect(pm.response.json().eventoId).to.eql(Number(pm.collectionVariables.get('outroEventoId'))));"
                ]
              }
            }
          ]
        },
        {
          "name": "Excluir inscrição",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/inscricoes/{{inscricaoId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('HTTP 204', () => pm.response.to.have.status(204));"
                ]
              }
            }
          ]
        },
        {
          "name": "Buscar inscrição excluída (espera 404)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/inscricoes/{{inscricaoId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('HTTP 404', () => pm.response.to.have.status(404));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "4. Perfil COMUM",
      "item": [
        {
          "name": "Login COMUM (salva o token)",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"login\": \"comum\",\n  \"senha\": \"{{senhaComum}}\"\n}"
            },
            "url": "{{baseUrl}}/auth/login"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.test('Perfil COMUM recebido', () => pm.expect(pm.response.json().perfil).to.eql('COMUM'));",
                  "if (pm.response.code === 200) pm.collectionVariables.set('token', pm.response.json().token);"
                ]
              }
            }
          ]
        },
        {
          "name": "COMUM pode listar",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/inscricoes"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "COMUM não pode criar (espera 403)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"eventoId\": {{eventoId}},\n  \"participanteId\": {{participanteId}}\n}"
            },
            "url": "{{baseUrl}}/inscricoes"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('HTTP 403', () => pm.response.to.have.status(403));"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
